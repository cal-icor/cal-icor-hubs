# OpenTofu / Terraform

# Provider plugins, modules, backend cache (per working dir)
.terraform/

# State files: may contain secrets in plaintext. We use a remote (gcs)
# backend, so these should never appear locally; ignore them as a safety net.
*.tfstate
*.tfstate.*

# Saved plan files: embed resource values, can contain secrets.
*.tfplan

# Crash logs
crash.log
crash.*.log

# Terragrunt per-unit working directory: the copied module source, the
# terragrunt-generated backend.tf, and a full .terraform/ with provider plugins.
# Regenerated on every run; never commit.
.terragrunt-cache/

# Debug output from `terragrunt run --all --terragrunt-debug` / `--terragrunt-debug`:
# renders the unit's merged inputs to disk and can embed secrets.
terragrunt-debug.tfvars.json

# Local-only overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# NOTE: .terraform.lock.hcl is intentionally NOT ignored. Commit it so provider
# versions are pinned across machines and CI.
