name: Deploy jupyterhub-home-nfs helm chart
# use echo ${VAR##*: } to get the value of a variable that is a string with a colon in it
permissions:
  contents: read
  id-token: write  # mint the OIDC token for keyless WIF auth
on:
  workflow_dispatch:
  push:
    branches:
      - staging

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Get PR labels
        id: pr-labels
        uses: irby/get-labels-on-push@v1.2.1
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Check out the hub repo
        uses: actions/checkout@v6
        with:
          fetch-depth: 1  # OR "2" -> To retrieve the preceding commit.
          sparse-checkout: |
            jupyterhub-home-nfs/
            .sops.yaml

      - name: Check if the jupyterhub-home-nfs helm chart needs to be deployed
        run: |
          echo "PR labels: ${{ steps.pr-labels.outputs.labels }}"
          for label in $(echo -e "${{ steps.pr-labels.outputs.labels }}"); do
            if [[ "$label" == jupyterhub-home-nfs-deployment ]]; then
              echo "Deploying jupyterhub-home-nfs charts!"
              echo "DEPLOY=1" >> "$GITHUB_ENV"
            fi
          done

      - name: Authenticate to the cluster (keyless WIF)
        if: ${{ env.DEPLOY }}
        uses: ./.github/actions/gke-auth
        with:
          workload_identity_provider: ${{ vars.PROD_WIF_PROVIDER }}
          service_account: ${{ vars.PROD_DEPLOY_SA }}
          cluster_name: ${{ vars.PROD_CLUSTER }}
          location: ${{ vars.PROD_ZONE }}
          project_id: ${{ vars.PROD_PROJECT }}

      - name: Install SOPS
        if: ${{ env.DEPLOY }}
        uses: ./.github/actions/install-sops

      - name: Decrypt jupyterhub-home-nfs secrets
        if: ${{ env.DEPLOY }}
        run: |
          sops -d -i jupyterhub-home-nfs/secrets/quota-overrides.yaml

      - name: Deploy jupyterhub-home-nfs helm chart
        if: ${{ env.DEPLOY }}
        run: |
          helm dep up jupyterhub-home-nfs
          helm upgrade --install \
            --namespace jupyterhub-home-nfs \
            --create-namespace jupyterhub-home-nfs \
            --values jupyterhub-home-nfs/values.yaml \
            --values jupyterhub-home-nfs/secrets/quota-overrides.yaml \
            jupyterhub-home-nfs
